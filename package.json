{
  "name": "poppy-lab",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @poppy-lab/playground --filter @poppy-lab/juniper --filter @poppy-lab/lantern --filter @poppy-lab/harborline --filter @poppy-lab/northwind --filter @poppy-lab/fernwick dev",
    "dev:playground": "pnpm --filter @poppy-lab/playground dev",
    "dev:juniper": "pnpm --filter @poppy-lab/juniper dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/smoke && tsc -p scripts/model-phrases",
    "test": "pnpm --workspace-concurrency=1 -r test --maxWorkers=2",
    "e2e": "pnpm --filter @poppy-lab/playground e2e",
    "scenarios": "node scripts/scenarios.mjs",
    "lint": "eslint apps packages scripts eslint.config.mjs",
    "format": "prettier --write apps packages scripts docs .github *.json *.yaml *.md eslint.config.mjs",
    "format:check": "prettier --check apps packages scripts docs .github *.json *.yaml *.md eslint.config.mjs",
    "dev:lantern": "pnpm --filter @poppy-lab/lantern dev",
    "dev:harborline": "pnpm --filter @poppy-lab/harborline dev",
    "dev:northwind": "pnpm --filter @poppy-lab/northwind dev",
    "dev:fernwick": "pnpm --filter @poppy-lab/fernwick dev",
    "spec:drift": "node scripts/spec-drift.mjs",
    "smoke:production": "pnpm --filter @poppy-lab/juniper exec tsx --tsconfig ../../scripts/smoke/tsconfig.json ../../scripts/smoke/production.ts",
    "phrases": "pnpm --filter @poppy-lab/juniper exec tsx --tsconfig ../../scripts/model-phrases/tsconfig.json ../../scripts/model-phrases/run.ts",
    "learn:diagrams": "node scripts/learn-diagrams/index.mjs",
    "learn:diagrams:check": "node scripts/learn-diagrams/index.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.3",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.0.18"
  }
}
