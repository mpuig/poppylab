{
  "name": "poppy-lab",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @poppy-lab/playground --filter @poppy-lab/juniper --filter @poppy-lab/lantern --filter @poppy-lab/harborline --filter @poppy-lab/northwind --filter @poppy-lab/fernwick dev",
    "dev:playground": "pnpm --filter @poppy-lab/playground dev",
    "dev:company": "pnpm --filter @poppy-lab/juniper dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --workspace-concurrency=1 -r test --maxWorkers=2",
    "scenarios": "node scripts/scenarios.mjs",
    "lint": "eslint apps packages scripts eslint.config.mjs",
    "format": "prettier --write apps packages scripts *.json *.yaml eslint.config.mjs",
    "format:check": "prettier --check apps packages scripts *.json *.yaml eslint.config.mjs",
    "dev:lantern": "pnpm --filter @poppy-lab/lantern dev",
    "dev:harborline": "pnpm --filter @poppy-lab/harborline dev",
    "dev:northwind": "pnpm --filter @poppy-lab/northwind dev",
    "dev:fernwick": "pnpm --filter @poppy-lab/fernwick dev",
    "spec:drift": "node scripts/spec-drift.mjs",
    "learn:diagrams": "node scripts/learn-diagrams/index.mjs",
    "learn:diagrams:check": "node scripts/learn-diagrams/index.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.18"
  }
}
