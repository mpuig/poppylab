# Dependencies and build output
node_modules/
.next/
.open-next/
.wrangler/
dist/
coverage/
# The browser scenario's results, traces and server logs (pnpm e2e)
test-results/
*.tsbuildinfo

# Secrets and local state: never committed
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
.poppy/
# `pnpm phrases` reports: a model's answers, for a person to read
scripts/model-phrases/reports/
*.pem
*.key

# Local copies of the published draft fetched by `pnpm spec:drift`
spec/**/*.latest.md

# Agent and editor tooling (local to each machine)
.codex/
.claude/
.cursor/
.agents/
.impeccable/
**/.impeccable/
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db
