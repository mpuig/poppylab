# Copy to apps/playground/.env.local. Never commit actual credentials.
# Demo mode needs none of these values.

# OpenAI or another OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=sonnet-5

GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Ollama adapter remains available internally; not a playground UI choice.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b

# PAP Sandbox needs publicly reachable HTTPS agent metadata.
# See docs/pap-sandbox.md for the identity-only relay; never tunnel port 3000.
# AGENT_PUBLIC_ORIGIN=https://your-playground.example
# Keep chat disabled in production until deployment access controls exist.
# CHAT_ENABLED=true

# MCP read tools: exact origin + locally verified tool names, never remote annotations alone.
# Signed-out reads only in this first block; see docs/mcp-readonly.md.
# This is an illustrative test origin, not an Ample configuration.
# PAP_MCP_READ_TOOLS={"https://mcp.example":["get_catalog"]}
