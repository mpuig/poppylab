{
  "name": "@poppy-lab/juniper",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/site-script.mjs --watch -- tsx watch src/node.ts",
    "build": "node scripts/site-script.mjs && tsc -p tsconfig.json --noEmit",
    "start": "node scripts/site-script.mjs && tsx src/node.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/site-script.mjs && vitest run src",
    "lint": "eslint .",
    "dev:worker": "node scripts/site-script.mjs && wrangler dev",
    "deploy": "node scripts/site-script.mjs && wrangler deploy",
    "site:script": "node scripts/site-script.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@poppy-lab/pap-client": "workspace:*",
    "@poppy-lab/pap-company": "workspace:*",
    "@poppy-lab/pap-core": "workspace:*",
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.167.0"
  }
}
